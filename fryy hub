local toastId = 0
local function message(text)
    toastId += 1
    local id = toastId
    toast.Text = text
    toast.Visible = true
    toast.BackgroundTransparency = 0

    task.delay(2.5, function()
        if id == toastId then
            toast.Visible = false
        end
    end)
end

local speed = 16
local function setSpeed(value)
    speed = math.clamp(value, 8, 32)
    speedLabel.Text = "WalkSpeed: " .. speed

    local character = player.Character
    local humanoid = character and
        character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        humanoid.WalkSpeed = speed
    end

    message("WalkSpeed set to " .. speed)
end

slower.Activated:Connect(function()
    setSpeed(speed - 4)
end)

faster.Activated:Connect(function()
    setSpeed(speed + 4)
end)

reset.Activated:Connect(function()
    setSpeed(16)
end)

teleport.Activated:Connect(function()
    local character = player.Character
    local root = character and
        character:FindFirstChild("HumanoidRootPart")

    if not root then
        message("Character is not ready yet!")
        return
    end

    local spawn = workspace:FindFirstChildWhichIsA(
        "SpawnLocation", true
    )

    if spawn then
        root.CFrame = spawn.CFrame + Vector3.new(0, 4, 0)
        message("Teleported to spawn!")
    else
        message("No SpawnLocation found in this game.")
    end
end)

